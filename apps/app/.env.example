# Data folder for the SQLite database and job files (outside the repo)
IFCWISE_DATA_DIR=C:\IFCWiseData
# 32+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
