# Vercel Blob — added automatically when a Blob store is connected to the Vercel project.
# Locally: `vercel env pull apps/app/.env.local` or paste the token here.
BLOB_READ_WRITE_TOKEN=

# Admin login (long random password) and cookie signing secret
ADMIN_PASSWORD=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Bearer token used by tools/ifc-tools (same generator as above)
ADMIN_API_TOKEN=
# 32-byte key, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_ENCRYPTION_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional email notifications
RESEND_API_KEY=
EMAIL_FROM=IFCWise <noreply@ifcwise.com>
ADMIN_EMAIL=

# Optional spam protection (Cloudflare Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
