ADMIN_INVITE_CODE=
APP_URL=http://localhost:3001
WWW_URL=http://localhost:3000
IFC_TOOLS_CMD=uv run --project ../../tools/ifc-tools ifc-tools
# Optional email notifications
RESEND_API_KEY=
EMAIL_FROM=IFCWise <noreply@ifcwise.com>
ADMIN_EMAIL=
