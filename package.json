{
  "name": "ifcwise",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n www,app -c blue,green \"npm:dev:www\" \"npm:dev:app\"",
    "dev:www": "npm run dev -w apps/www",
    "dev:app": "npm run dev -w apps/app",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "tools": "uv run --project tools/ifc-tools ifc-tools",
    "test:tools": "uv run --project tools/ifc-tools pytest",
    "samples": "uv run --project tools/ifc-tools python tools/ifc-tools/samples/build_samples.py"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "overrides": {
    "three": "0.182.0",
    "web-ifc": "0.0.77"
  }
}
